{
  "name": "dbd-tracker-overlay",
  "version": "1.0.2",
  "description": "DBD Stats Overlay",
  "author": "local",
  "private": true,
  "type": "module",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adrian-ESoftware/DBDTracker.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --publish never"
  },
  "devDependencies": {
    "electron": "36.3.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "local.dbdtracker.overlay",
    "productName": "DBD Tracker Overlay",
    "artifactName": "DBD-Tracker-Overlay-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Adrian-ESoftware",
      "repo": "DBDTracker"
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.cjs",
      "database.js",
      "server.js",
      "background-collector.js",
      "dbd-map-catalog.json",
      "overlay.html",
      "tray_icons",
      "map_overlays",
      ".env"
    ],
    "win": {
      "target": "portable",
      "icon": "tray_icons/Icon.png",
      "extraResources": [
        {
          "from": "../map-check/target/electron/map-check.exe",
          "to": "map-check/map-check.exe"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "tray_icons/Icon.png",
      "extraResources": [
        {
          "from": "../map-check/target/electron/map-check",
          "to": "map-check/map-check"
        }
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "dotenv": "^17.4.2"
  }
}
