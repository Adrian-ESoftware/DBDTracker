{
  "name": "dbd-tracker-overlay",
  "version": "1.3.1",
  "description": "DBD Tracker Overlay - Estatisticas e HUD em tempo real para Dead by Daylight",
  "author": "Adrian Software",
  "private": true,
  "type": "module",
  "allowScripts": {
    "electron@36.3.1": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adrian-ESoftware/DBDTracker.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --publish never"
  },
  "devDependencies": {
    "electron": "36.3.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.adrian.dbdtracker.overlay",
    "productName": "DBD Tracker Overlay",
    "copyright": "Copyright © 2026 Adrian Software",
    "publish": {
      "provider": "github",
      "owner": "Adrian-ESoftware",
      "repo": "DBDTracker"
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.cjs",
      "database.js",
      "server.js",
      "background-collector.js",
      "community.js",
      "updater.js",
      "wiki-catalog.js",
      "community-config.json",
      "dbd-map-catalog.json",
      "overlay.html",
      "tray_icons",
      "map_overlays"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "tray_icons/Icon.png",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "DBD Tracker",
      "extraResources": [
        {
          "from": "../map-check/target/electron/map-check.exe",
          "to": "map-check/map-check.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DBD Tracker Overlay",
      "uninstallDisplayName": "DBD Tracker Overlay",
      "artifactName": "DBD-Tracker-Overlay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DBD-Tracker-Overlay-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "DBD-Tracker-Overlay-${version}.${ext}",
      "category": "Game",
      "icon": "tray_icons/Icon.png",
      "extraResources": [
        {
          "from": "../map-check/target/electron/map-check",
          "to": "map-check/map-check"
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
