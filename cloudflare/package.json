{
  "name": "dbd-tracker-community-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker and D1 backend for DBD Tracker Community",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute dbd-tracker-community --local --file=schema.sql",
    "d1:init:remote": "wrangler d1 execute dbd-tracker-community --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
